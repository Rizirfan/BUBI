PORT=3001
JWT_SECRET=change-me-in-production
# SQLite: on Render use a persistent disk, e.g. file:/var/data/dev.db
DATABASE_URL="file:./dev.db"
# Set to your Vercel frontend URL in production, e.g. https://your-app.vercel.app
# Multiple origins can be comma-separated, e.g. https://bubi-ivory.vercel.app,http://localhost:5173
CORS_ORIGIN=https://bubi-ivory.vercel.app,http://localhost:5173
